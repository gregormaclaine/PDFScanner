# -----------------------------------------------------------------------------
# PDFScanner - Environment Template
# Copy this file to `.env` and replace placeholder values.
# -----------------------------------------------------------------------------

# =============================
# Core Security (REQUIRED)
# =============================

# Internal shared API key required on protected endpoints via `X-API-Key`.
# Generate a long random value (32+ chars).
INTERNAL_API_KEY=

# Secret used to sign JWT access tokens (HS256).
# Must be long and random; rotate regularly.
JWT_SECRET=

# BCrypt hash for admin login password.
# Generate via: python util_hash.py "YourAdminPassword"
ADMIN_PASSWORD_HASH=

# BCrypt hash for standard user login password.
# Generate via: python util_hash.py "YourUserPassword"
USER_PASSWORD_HASH=


# =============================
# AI / OCR Providers
# =============================

# OpenAI API key used by metadata extraction logic.
# Required by app startup checks.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI model name for metadata extraction.
# Optional; defaults to `gpt-4o` if omitted.
LLM_MODEL=gpt-4o

# Path to Google service account JSON for Vision OCR.
# Optional; if omitted, Google default application credentials are used.
# Example: /absolute/path/to/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=


# =============================
# API / Runtime
# =============================

# Allowed frontend origins for CORS.
# Comma-separated list; no spaces preferred.
# Example: http://localhost:3000,https://app.example.com
ALLOWED_ORIGIN=http://localhost:3000

# API bind host used when running `python main.py`.
# Optional; defaults to 127.0.0.1.
HOST=127.0.0.1

# API bind port used when running `python main.py`.
# Optional; defaults to 8000.
PORT=8000
